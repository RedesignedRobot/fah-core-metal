From fe6db3ef65f5ddaba987e28028a5014e8b7d305a Mon Sep 17 00:00:00 2001
From: Amir Ayub <dev.amirayub@gmail.com>
Date: Sat, 10 Oct 2026 21:50:35 +0300
Subject: [PATCH 1/3] Generate the Metal kernel sources through one custom
 target

With OPENMM_BUILD_STATIC_LIB=ON, sharedTarget and staticTarget each added a
rule for MetalKernelSources.cpp and Ninja refused the build graph (multiple
rules generate platforms/metal/src/MetalKernelSources.cpp). The rule now lives
in platforms/metal as MetalKernels, and both targets depend on it.
---
 platforms/metal/CMakeLists.txt              | 11 +++++++++++
 platforms/metal/sharedTarget/CMakeLists.txt |  8 +-------
 platforms/metal/staticTarget/CMakeLists.txt |  7 +------
 3 files changed, 13 insertions(+), 13 deletions(-)

diff --git a/platforms/metal/CMakeLists.txt b/platforms/metal/CMakeLists.txt
index 63da22e42..ab154854a 100644
--- a/platforms/metal/CMakeLists.txt
+++ b/platforms/metal/CMakeLists.txt
@@ -85,6 +85,17 @@ SET(SOURCE_FILES ${SOURCE_FILES} ${KERNELS_CPP} ${KERNELS_H} ${COMMON_KERNELS_CP
 INCLUDE_DIRECTORIES(BEFORE ${CMAKE_CURRENT_BINARY_DIR}/src)
 INCLUDE_DIRECTORIES(BEFORE ${CMAKE_CURRENT_BINARY_DIR}/../common/src)
 
+# One rule for the generated kernel sources, shared by sharedTarget and staticTarget: Ninja refuses two
+# rules for the same output, so a static build next to the shared one needs the custom target.
+FILE(GLOB METAL_KERNELS ${KERNEL_SOURCE_DIR}/kernels/*.metal)
+ADD_CUSTOM_COMMAND(OUTPUT ${KERNELS_CPP} ${KERNELS_H}
+    COMMAND ${CMAKE_COMMAND}
+    ARGS -D KERNEL_SOURCE_DIR=${KERNEL_SOURCE_DIR} -D KERNELS_CPP=${KERNELS_CPP} -D KERNELS_H=${KERNELS_H} -D KERNEL_SOURCE_CLASS=${KERNEL_SOURCE_CLASS} -D KERNEL_FILE_EXTENSION=metal -P ${CMAKE_SOURCE_DIR}/cmake_modules/EncodeKernelFiles.cmake
+    DEPENDS ${METAL_KERNELS}
+)
+SET_SOURCE_FILES_PROPERTIES(${KERNELS_CPP} ${KERNELS_H} PROPERTIES GENERATED TRUE)
+ADD_CUSTOM_TARGET(MetalKernels DEPENDS ${KERNELS_CPP} ${KERNELS_H})
+
 # Install headers
 
 FILE(GLOB CORE_HEADERS include/*.h ${KERNELS_H})
diff --git a/platforms/metal/sharedTarget/CMakeLists.txt b/platforms/metal/sharedTarget/CMakeLists.txt
index 5be383997..5325cf1fe 100644
--- a/platforms/metal/sharedTarget/CMakeLists.txt
+++ b/platforms/metal/sharedTarget/CMakeLists.txt
@@ -2,15 +2,9 @@
 # Include Metal related files.
 #
 
-FILE(GLOB METAL_KERNELS ${KERNEL_SOURCE_DIR}/kernels/*.metal)
-ADD_CUSTOM_COMMAND(OUTPUT ${KERNELS_CPP} ${KERNELS_H}
-    COMMAND ${CMAKE_COMMAND}
-    ARGS -D KERNEL_SOURCE_DIR=${KERNEL_SOURCE_DIR} -D KERNELS_CPP=${KERNELS_CPP} -D KERNELS_H=${KERNELS_H} -D KERNEL_SOURCE_CLASS=${KERNEL_SOURCE_CLASS} -D KERNEL_FILE_EXTENSION=metal -P ${CMAKE_SOURCE_DIR}/cmake_modules/EncodeKernelFiles.cmake
-    DEPENDS ${METAL_KERNELS}
-)
 SET_SOURCE_FILES_PROPERTIES(${KERNELS_CPP} ${KERNELS_H} ${COMMON_KERNELS_CPP} PROPERTIES GENERATED TRUE)
 ADD_LIBRARY(${SHARED_TARGET} SHARED ${SOURCE_FILES} ${SOURCE_INCLUDE_FILES} ${API_ABS_INCLUDE_FILES})
-ADD_DEPENDENCIES(${SHARED_TARGET} CommonKernels)
+ADD_DEPENDENCIES(${SHARED_TARGET} CommonKernels MetalKernels)
 
 TARGET_LINK_LIBRARIES(${SHARED_TARGET} ${OPENMM_LIBRARY_NAME} "-framework Foundation -framework Metal -framework QuartzCore -framework IOKit")
 SET_TARGET_PROPERTIES(${SHARED_TARGET} PROPERTIES COMPILE_FLAGS "${EXTRA_COMPILE_FLAGS} -DOPENMM_COMMON_BUILDING_SHARED_LIBRARY")
diff --git a/platforms/metal/staticTarget/CMakeLists.txt b/platforms/metal/staticTarget/CMakeLists.txt
index dc3eb2d70..9ecdb87f8 100644
--- a/platforms/metal/staticTarget/CMakeLists.txt
+++ b/platforms/metal/staticTarget/CMakeLists.txt
@@ -2,14 +2,9 @@
 # Include METAL related files.
 #
 
-FILE(GLOB METAL_KERNELS ${KERNEL_SOURCE_DIR}/kernels/*.metal)
-ADD_CUSTOM_COMMAND(OUTPUT ${KERNELS_CPP} ${KERNELS_H}
-    COMMAND ${CMAKE_COMMAND}
-    ARGS -D KERNEL_SOURCE_DIR=${KERNEL_SOURCE_DIR} -D KERNELS_CPP=${KERNELS_CPP} -D KERNELS_H=${KERNELS_H} -D KERNEL_SOURCE_CLASS=${KERNEL_SOURCE_CLASS} -D KERNEL_FILE_EXTENSION=metal -P ${CMAKE_SOURCE_DIR}/cmake_modules/EncodeKernelFiles.cmake
-    DEPENDS ${METAL_KERNELS}
-)
 SET_SOURCE_FILES_PROPERTIES(${KERNELS_CPP} ${KERNELS_H} PROPERTIES GENERATED TRUE)
 ADD_LIBRARY(${STATIC_TARGET} STATIC ${SOURCE_FILES} ${SOURCE_INCLUDE_FILES} ${API_ABS_INCLUDE_FILES})
+ADD_DEPENDENCIES(${STATIC_TARGET} MetalKernels)
 
 TARGET_LINK_LIBRARIES(${STATIC_TARGET} ${OPENMM_LIBRARY_NAME} "-framework Foundation -framework Metal -framework QuartzCore -framework IOKit")
 SET_TARGET_PROPERTIES(${STATIC_TARGET} PROPERTIES COMPILE_FLAGS "${EXTRA_COMPILE_FLAGS} -DOPENMM_COMMON_BUILDING_STATIC_LIBRARY")
