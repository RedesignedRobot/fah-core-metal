From 9d01ffc9e8d5bfdc1ee06a3bd99745b98f35c3e5 Mon Sep 17 00:00:00 2001
From: Amir Ayub <dev.amirayub@gmail.com>
Date: Sat, 17 Oct 2026 16:55:27 +0300
Subject: [PATCH 6/6] Size OpenCL work groups from CL_KERNEL_WORK_GROUP_SIZE on
 a CPU device

Apple's OpenCL CPU device reports a device maximum of 1024 but compiles
kernels such as clearBuffer for smaller work groups, so enqueueing them
at 128 fails with CL_INVALID_WORK_GROUP_SIZE (-54). On a CPU device,
executeKernel now caps the block size at the kernel's own limit, and the
error names the work group it tried.
---
 platforms/opencl/include/OpenCLContext.h | 4 ++--
 platforms/opencl/src/OpenCLContext.cpp   | 7 ++++++-
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/platforms/opencl/include/OpenCLContext.h b/platforms/opencl/include/OpenCLContext.h
index 782efb7fb..d12e13481 100644
--- a/platforms/opencl/include/OpenCLContext.h
+++ b/platforms/opencl/include/OpenCLContext.h
@@ -350,7 +350,7 @@ public:
      * may be more efficient on CPUs and GPUs.
      */
     bool getIsCPU() const {
-        return (device.getInfo<CL_DEVICE_TYPE>() == CL_DEVICE_TYPE_CPU);
+        return isCPU;
     }
     /**
      * Get the SIMD width of the device being used.
@@ -520,7 +520,7 @@ private:
     int contextIndex;
     int numForceBuffers;
     int simdWidth;
-    bool supports64BitGlobalAtomics, supportsDoublePrecision;
+    bool supports64BitGlobalAtomics, supportsDoublePrecision, isCPU;
     mm_float4 periodicBoxSize, invPeriodicBoxSize, periodicBoxVecX, periodicBoxVecY, periodicBoxVecZ;
     mm_double4 periodicBoxSizeDouble, invPeriodicBoxSizeDouble, periodicBoxVecXDouble, periodicBoxVecYDouble, periodicBoxVecZDouble;
     std::string defaultOptimizationOptions;
diff --git a/platforms/opencl/src/OpenCLContext.cpp b/platforms/opencl/src/OpenCLContext.cpp
index f4e298841..4cbf23af1 100644
--- a/platforms/opencl/src/OpenCLContext.cpp
+++ b/platforms/opencl/src/OpenCLContext.cpp
@@ -201,6 +201,7 @@ OpenCLContext::OpenCLContext(const System& system, int platformIndex, int device
         platforms[bestPlatform].getDevices(CL_DEVICE_TYPE_GPU | CL_DEVICE_TYPE_CPU, &devices);
         string platformVendor = platforms[bestPlatform].getInfo<CL_PLATFORM_VENDOR>();
         device = devices[bestDevice];
+        isCPU = (device.getInfo<CL_DEVICE_TYPE>() == CL_DEVICE_TYPE_CPU);
 
         this->deviceIndex = bestDevice;
         this->platformIndex = bestPlatform;
@@ -693,6 +694,10 @@ OpenCLArray& OpenCLContext::unwrap(ArrayInterface& array) const {
 void OpenCLContext::executeKernel(cl::Kernel& kernel, int workUnits, int blockSize) {
     if (blockSize == -1)
         blockSize = ThreadBlockSize;
+    // A CPU device can compile a kernel for smaller work groups than the device maximum (Apple's CPU device
+    // does), and enqueueing a larger group fails with CL_INVALID_WORK_GROUP_SIZE.
+    if (getIsCPU())
+        blockSize = std::min(blockSize, (int) kernel.getWorkGroupInfo<CL_KERNEL_WORK_GROUP_SIZE>(device));
     int size = std::min((workUnits+blockSize-1)/blockSize, numThreadBlocks)*blockSize;
     try {
 #ifdef ENABLE_PROFILING
@@ -708,7 +713,7 @@ void OpenCLContext::executeKernel(cl::Kernel& kernel, int workUnits, int blockSi
     }
     catch (cl::Error err) {
         stringstream str;
-        str<<"Error invoking kernel "<<kernel.getInfo<CL_KERNEL_FUNCTION_NAME>()<<": "<<err.what()<<" ("<<err.err()<<")";
+        str<<"Error invoking kernel "<<kernel.getInfo<CL_KERNEL_FUNCTION_NAME>()<<": "<<err.what()<<" ("<<err.err()<<"), work group "<<blockSize;
         throw OpenMMException(str.str());
     }
 }
